Frontend/.next/
Frontend/out/
Frontend/build/
Frontend/.env*
Frontend/*.tsbuildinfo
Frontend/next-env.d.ts

# Backend Python / Node configurations
Backend/venv/
Backend/.venv/
Backend/env/
Backend/.env
Backend/__pycache__/
Backend/*.pyc
Backend/*.db
Backend/*.sqlite
Backend/node_modules/
